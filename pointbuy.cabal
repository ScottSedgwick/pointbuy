cabal-version:      3.0
name:               pointbuy
version:            0.1.0.0
synopsis:           A simple point-buy character generator for tabletop RPGs.
category:           Web


license:            BSD-3-Clause
license-file:       LICENSE
author:             ssedgwick
maintainer:         ssedgwick@cochlear.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md


common wasm
  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM

executable pointbuy
    import:           wasm
    main-is:          Main.hs
    other-modules:    Types
                    , Types.Encoding
                    , Types.Races
                    , Types.Stats
                    , View.Calculator
                    , View.Calculator.Race
                    , View.Custom
                    , View.Main
                    , View.Raw
    build-depends:    base
                    , aeson
                    , base64-bytestring
                    , bytestring
                    , cereal
                    , containers
                    , data-default
                    , jsaddle
                    , jsaddle-wasm
                    , lens
                    , miso ^>= 1.8
                    , text
                    , uri-encode
                    , zlib
    hs-source-dirs:   app
    default-language: Haskell2010
