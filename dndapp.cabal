cabal-version:      3.0
name:               dndapp
version:            0.1.0.0
synopsis:           All-in-one collection of D&D 5e helper applications
category:           Web
license:            BSD-3-Clause
license-file:       LICENSE
author:             ssedgwick
maintainer:         ssedgwick@cochlear.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common wasm
  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM

executable dndapp
    import:             wasm
    main-is:            Main.hs
    other-modules:      App.Main
                      , App.Background
                      , App.Ciphers
                      , App.Crafting
                      , App.Dice
                      , App.Feats
                      , App.Insults
                      , App.Items
                      , App.Lineages
                      , App.PointBuy
                      , App.Spells
                      , Common.Applications
                      , Common.Classes
                      , Common.Ciphers.Affine
                      , Common.Ciphers.Atbash
                      , Common.Ciphers.Caesar
                      , Common.Ciphers.RailFence
                      , Common.Ciphers.Scytale
                      , Common.Ciphers.Utils
                      , Common.Components
                      , Common.DataTypes.Background
                      , Common.DataTypes.Inline
                      , Common.Sources
                      , Common.Unshow
                      , Common.Utils
    build-depends:      base == 4.21.0.0
                      , aeson == 2.2.3.0
                      , base64-bytestring == 1.2.1.0
                      , bytestring == 0.12.2.0
                      , cereal == 0.5.8.3
                      , containers == 0.8
                      , data-default == 0.8.0.1
                      , jsaddle == 0.9.9.3
                      , jsaddle-wasm == 0.1.2.1
                      , lens == 5.3.5
                      , matrix
                      , miso == 1.9.0.0
                      , random
                      , text == 2.1.3
                      , uri-encode == 1.5.0.7
                      , vector
                      , zlib == 0.7.1.1
    hs-source-dirs:     app
    default-language:   Haskell2010
    default-extensions: DeriveGeneric
                      , DerivingStrategies
                      , OverloadedStrings
                      , TemplateHaskell
